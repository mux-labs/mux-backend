# Mux Backend environment configuration (example)
# Copy to .env and fill in real values. Never commit real secrets.

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/mux

# --- Auth / API keys ---
# JWT_SECRET=replace-with-strong-random-secret
# API_KEY_PEPPER=replace-with-strong-random-pepper

# --- Mainnet payment feature flag (#881) ---
# Fail-closed kill-switch for the mainnet payment money-path.
# Default is OFF: mainnet payments are DENIED unless explicitly enabled.
# Testnet behavior is unaffected by this flag.
# Set to "true" only after the mainnet readiness checklist is complete.
MAINNET_PAYMENT_ENABLED=false

# Optional: Interval between scheduled balance sync runs, in ms (default: 600000 / 10 minutes)
BALANCE_SYNC_INTERVAL_MS=600000
# Optional: Max retries for a failed balance sync run (default: 3)
BALANCE_SYNC_MAX_RETRIES=3
# Optional: Milliseconds before an indexed balance is reported as stale (default: 300000 / 5 minutes). Must be a positive integer.
BALANCE_STALE_THRESHOLD_MS=300000

# ------------------------------------------------------------
# CORS
# Optional: Comma-separated list of allowed origins (default: http://localhost:3000)
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Webhooks
# Optional: Delivery retry configuration
# ------------------------------------------------------------
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BACKOFF_MS=1000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_CONSECUTIVE_FAILURES=10
WEBHOOK_QUEUE_INTERVAL_MS=30000

# Secret for verifying incoming webhooks (HMAC-SHA256 signature verification)
WEBHOOK_INBOUND_SECRET=your-inbound-webhook-secret

# ------------------------------------------------------------
# Recovery
# Optional: Time-to-live for recovery requests before they are expired
# Default: 604800000 (7 days)
# ------------------------------------------------------------
RECOVERY_REQUEST_TTL_MS=604800000

# Wallet orchestration (create-or-get) surface. Deny-by-default: only the
# exact string "true" enables it. Gated because it is a money-path surface —
# set to false to disable wallet creation immediately during an incident.
# See docs/WALLET-API.md and verify-orchestrator-retries.sh
# ------------------------------------------------------------
FEATURE_WALLET_ORCHESTRATOR=false

# ------------------------------------------------------------
# Idempotency TTL cleanup
# ------------------------------------------------------------
# Idempotency TTL cleanup
# Prunes expired IdempotencyRecord rows so the table does not grow
# without bound. Opt-in / deny-by-default: only "true" starts the
# in-process worker. Leave disabled when an external scheduler
# (Kubernetes CronJob) triggers cleanup instead, so cleanup runs in
# exactly one place. See docs/IDEMPOTENCY-TTL.md
# ------------------------------------------------------------
IDEMPOTENCY_CLEANUP_ENABLED=false
# How often (ms) to run a cleanup pass. Default: 3600000 (1 hour)
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
# Rows deleted per pass (clamped to 10000). Default: 1000
IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
# Mainnet payment submission kill-switch (default: false)
# Set to "true" ONLY in production when the sponsor account is
# funded and all security policies are reviewed.
# See docs/MAINNET-PAYMENT-FEATURE-FLAG.md for details.
FEATURE_MAINNET_PAYMENT_SUBMIT=false

# ------------------------------------------------------------
# Fee-Bump / Sponsor
# Required for fee-bump transactions: Stellar secret key of the
# sponsor account that pays fees on behalf of users.
# ------------------------------------------------------------
# STELLAR_SPONSOR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Transaction Environment Validator (fail-closed boot gate, #914)
# In production, enabling FEATURE_MAINNET_PAYMENTS or
# FEATURE_MAINNET_PAYMENT_SUBMIT without STELLAR_HORIZON_MAINNET_URL
# prevents the application from booting.
# See docs/MAINNET-PAYMENT-FEATURE-FLAG.md.
# ------------------------------------------------------------
STELLAR_HORIZON_MAINNET_URL=https://horizon.stellar.org
FEATURE_MAINNET_PAYMENTS=false

# ------------------------------------------------------------
# Per-developer API quotas (#955)
# An aggregate, tenant-level limit applied IN ADDITION to the per-API-key rate
# limit. A developer is counted across every key and project they own, so
# holding more keys does not buy more throughput.
#
# Deny-by-default: quotas are OFF unless this is exactly "true". A deployment
# that has not opted in behaves exactly as before.
# ------------------------------------------------------------
DEVELOPER_QUOTAS_ENABLED=false
# Requests per window for a developer with no explicit quota (clamped to
# 1..DEVELOPER_QUOTA_MAX_RPM, default: 600)
DEVELOPER_QUOTA_DEFAULT_RPM=600
# Sliding window length in ms (default: 60000)
DEVELOPER_QUOTA_WINDOW_MS=60000
# Hard ceiling on any per-developer quota. Raising this is a deliberate act, so a
# typo cannot open the API to a single tenant. Default: 10000
DEVELOPER_QUOTA_MAX_RPM=10000

# RateLimitRecord cleanup (deny-by-default; see docs/DEVELOPER-QUOTAS.md)
RATE_LIMIT_CLEANUP_ENABLED=false
RATE_LIMIT_CLEANUP_INTERVAL_MS=3600000
RATE_LIMIT_CLEANUP_BATCH_SIZE=1000

# Soroban RPC retry policy (#953)
# Bounded retries for TRANSIENT Soroban RPC failures only (408/425/429/5xx and
# transport errors). Permanent errors — any other 4xx, or an error this policy
# does not recognise — are never retried.
#
# A failed simulation is NEVER submitted, retried or not.
#
# IMPORTANT: a failed `submit` is NOT retried by default. A lost submit response
# is ambiguous (the transaction may have landed), so a blind retry risks a
# duplicate on chain. Only enable SOROBAN_RPC_RETRY_SUBMIT=true if the RPC layer
# guarantees idempotent submission. See docs/SOROBAN-RPC-RETRY.md
# ------------------------------------------------------------
# Total attempts including the first (clamped to 1..10, default: 3)
SOROBAN_RPC_MAX_ATTEMPTS=3
# Base backoff in ms (capped at 10000, default: 200). Exponential with full jitter.
SOROBAN_RPC_RETRY_BACKOFF_MS=200
# Total wall-clock budget for all attempts and waits, in ms (default: 5000)
SOROBAN_RPC_DEADLINE_MS=5000
# Deny-by-default: leave false unless submission is provably idempotent.
SOROBAN_RPC_RETRY_SUBMIT=false

# Soroban contract invocation (#919, #954)
# Deny-by-default kill-switch. Only the exact string "true" (or "1") enables
# contract invocation; see docs/FEATURE-FLAGS.md.
#
# When enabled, EVERY allowlisted contract in
# src/soroban/soroban-invoke.model.ts must have a syntactically valid Soroban
# contract id configured per network, or the application REFUSES TO BOOT.
# Ids are validated as StrKeys: 56 characters, "C" contract version byte,
# correct base32 alphabet, and a valid CRC-16 checksum.
# The same id may not be used for both networks (copy-paste misconfig).
# Failure codes: SOROBAN_CONTRACT_ID_MISSING / _INVALID / _NETWORK_COLLISION.
#
# Variable naming: SOROBAN_CONTRACT_<CONTRACT>_<NETWORK>_ID
#   SOROBAN_CONTRACT_WALLET_REGISTRY_TESTNET_ID
#   SOROBAN_CONTRACT_WALLET_REGISTRY_MAINNET_ID
#   SOROBAN_CONTRACT_SPEND_LIMIT_TESTNET_ID
#
# A mainnet id is required only for contracts with at least one
# mainnet-enabled function. See docs/SOROBAN-CONTRACT-ID-BOOT.md.
# ------------------------------------------------------------
SOROBAN_INVOKE_ENABLED=false

# Auth Rate Limiting Configuration
# Maximum number of authentication attempts per IP address per window
AUTH_RATE_LIMIT_MAX=10
# Time window in milliseconds for auth rate limiting (default: 60 seconds)
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------
# API Key Expiry
# Optional: Default lifetime (in whole days) for newly created API keys.
# When set to a positive integer, createApi
